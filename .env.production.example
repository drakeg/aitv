# Public hostname used by Caddy for automatic HTTPS.
PUBLIC_HOST=aitv.example.com

# Host ports for the public reverse proxy.
HTTP_PORT=80
HTTPS_PORT=443

# Required Django production settings.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=aitv.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://aitv.example.com
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Persistent single-host SQLite storage.
SQLITE_DB_PATH=/data/db.sqlite3
SQLITE_TIMEOUT_SECONDS=30

# Gunicorn defaults are intentionally conservative for SQLite.
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
GUNICORN_TIMEOUT_SECONDS=30

# Optional live-source credentials/timeouts.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_TIMEOUT_SECONDS=5
SOURCE_TIMEOUT_SECONDS=5

# Optional recurring EPG worker.
EPG_REGIONS=US
EPG_REFRESH_INTERVAL_SECONDS=1800
EPG_RETENTION_HOURS=6
EPG_DAYS=2
EPG_STALE_AFTER_SECONDS=7200

# Optional recurring Favorite-release checks.
RELEASE_CHECK_INTERVAL_SECONDS=3600

# Optional SMTP delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=
